# Server environment only. Never copy these credentials into Flutter.
# Load these values into the process environment using your secret manager.
ELASTICSEARCH_URL=https://my-vectordb-project-e1e44b.es.us-central1.gcp.elastic.cloud:443
ELASTICSEARCH_API_KEY=
# Separate alias for the authenticated FastAPI vector API.
# The Node.js adapter and public /querysession endpoint use the existing conversations index.
ELASTICSEARCH_INDEX=conversation-garden-conversations
# Pinned text_embedding endpoint from the existing Elastic project setup.
ELASTICSEARCH_INFERENCE_ID=.jina-embeddings-v5-text-small
# Random service-to-service bearer token, at least 32 characters.
# Required when running FastAPI with ELASTICSEARCH_INFERENCE_ID set.
CONVERSATION_API_TOKEN=
